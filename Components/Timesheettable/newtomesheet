import React, { useMemo, useState } from "react";
import {Checkbox,Table,TableBody,TableCell,TableContainer,TableHead,TableRow,IconButton, Stack, Box, FormControl, InputLabel, Select, MenuItem, Button,} from "@mui/material";
import EditIcon from '@mui/icons-material/Edit';
import DeleteIcon from '@mui/icons-material/Delete';
import type { Timesheet } from "../../Interfaces/Timesheet";

interface TableHeadData {
  name: string;
  id: string;
}

const tableheaddata: TableHeadData[] = [
  { name: "Employee Name", id: "name" },
  { name: "Date", id: "date" },
  { name: "Login Time", id: "loginTime" },
  { name: "Logout Time", id: "logoutTime" },
  { name: "Project Name", id: "project" },
  { name: "Task Name", id: "task" },
  { name: "Task Priority", id: "priority" },
  { name: "Status", id: "status" },
];

const TableHeadStyle = {backgroundColor: "rgb(25,118,210)",color: "#ffffff",fontWeight: 600,};
const TableBoxStyle = { mt: 8 };

interface IProps {
  data: Timesheet[];
  onEdit?: (row: Timesheet) => void;
  onDelete?: (id: string) => void;
}

const TimesheetTable: React.FC<IProps> = ( prop ) => {
  const [selectedYear, setSelectedYear] = useState<string>("all");
  const [selectedMonth, setSelectedMonth] = useState<string>("all");
  const [selectedDate, setSelectedDate] = useState<string>("all");

  const { years, months, dates } = useMemo(() => {
    const ys = new Set<string>();
    const ms = new Set<string>();
    const ds = new Set<string>();
    prop.data?.forEach((r) => {
      if (!r.date) return;
      const parts = r.date.split("-");
      if (parts.length >= 3) {
        const y = parts[0];
        const m = `${parts[1]}`;
        const full = r.date;
        ys.add(y);
        ms.add(`${y}-${m}`);
        ds.add(full);
      }
    });
    return {
      years: Array.from(ys).sort(),
      months: Array.from(ms).sort(),
      dates: Array.from(ds).sort(),
    };
  }, [prop.data]);

  const resetFilters = () => {
    setSelectedYear("all");
    setSelectedMonth("all");
    setSelectedDate("all");
  };

  const filteredData = useMemo(() => {
    return prop.data?.filter((r) => {
      if (selectedYear !== "all") {
        if (!r.date.startsWith(selectedYear)) return false;
      }
      if (selectedMonth !== "all") {
        if (!r.date.startsWith(selectedMonth)) return false;
      }
      if (selectedDate !== "all") {
        if (r.date !== selectedDate) return false;
      }
      return true;
    }) ?? [];
  }, [prop.data, selectedYear, selectedMonth, selectedDate]);

  return (
    <TableContainer sx={TableBoxStyle}>
      <Box sx={{ display: 'flex', gap: 2, alignItems: 'center', mb: 2, p: 1 }}>
        <FormControl size="small" sx={{ minWidth: 120 }}>
          <InputLabel id="filter-year-label">Year</InputLabel>
          <Select
            labelId="filter-year-label"
            value={selectedYear}
            label="Year"
            onChange={(e) => { setSelectedYear(e.target.value); setSelectedMonth('all'); setSelectedDate('all'); }}
          >
            <MenuItem value="all">All</MenuItem>
            {years.map((y) => (
              <MenuItem key={y} value={y}>{y}</MenuItem>
            ))}
          </Select>
        </FormControl>

        <FormControl size="small" sx={{ minWidth: 160 }}>
          <InputLabel id="filter-month-label">Month</InputLabel>
          <Select
            labelId="filter-month-label"
            value={selectedMonth}
            label="Month"
            onChange={(e) => { setSelectedMonth(e.target.value); setSelectedDate('all'); }}
          >
            <MenuItem value="all">All</MenuItem>
            {months
              .filter((m) => selectedYear === "all" ? true : m.startsWith(selectedYear))
              .map((m) => {
                const [_y, mm] = m.split('-');
                const monthName = new Date(`${m}-01`).toLocaleString(undefined, { month: 'short' });
                return (
                  <MenuItem key={m} value={m}>{`${_y}-${mm} (${monthName})`}</MenuItem>
                );
              })}
          </Select>
        </FormControl>

        <FormControl size="small" sx={{ minWidth: 160 }}>
          <InputLabel id="filter-date-label">Date</InputLabel>
          <Select
            labelId="filter-date-label"
            value={selectedDate}
            label="Date"
            onChange={(e) => setSelectedDate(e.target.value)}
          >
            <MenuItem value="all">All</MenuItem>
            {dates
              .filter((d) => {
                if (selectedYear !== "all" && !d.startsWith(selectedYear)) return false;
                if (selectedMonth !== "all" && !d.startsWith(selectedMonth)) return false;
                return true;
              })
              .map((d) => (
                <MenuItem key={d} value={d}>{d}</MenuItem>
              ))}
          </Select>
        </FormControl>

        <Button size="small" onClick={resetFilters}>Reset</Button>
      </Box>
      <Table>
        <TableHead>
          <TableRow>
            <TableCell sx={TableHeadStyle}>
              <Checkbox />
            </TableCell>
            {tableheaddata.map((td) => (
              <TableCell sx={TableHeadStyle} key={td.id}>
                {td.name}
              </TableCell>
            ))}
            <TableCell sx={TableHeadStyle}>Actions</TableCell>
          </TableRow>
        </TableHead>
         <TableBody>
      {(!filteredData || filteredData.length === 0) ? (
                <TableRow>
        <TableCell colSpan={tableheaddata.length + 2} align="center">
          No timesheet entries found. Please add some data.
                </TableCell>
                </TableRow>
      ) : (
        filteredData.map((row) => (
                <TableRow key={row.id}>
                    <TableCell><Checkbox /></TableCell>
                    <TableCell>{row.name}</TableCell>
                    <TableCell>{row.date}</TableCell>
                    <TableCell>{row.loginTime}</TableCell>
                    <TableCell>{row.logoutTime}</TableCell>
                    <TableCell>{row.project}</TableCell>
                    <TableCell>{row.task}</TableCell>
                    <TableCell>{row.priority}</TableCell>
                    <TableCell>{row.status}</TableCell>
                    <TableCell>
                        <Stack direction="row" spacing={1}>
                            <IconButton size="small" color="primary" onClick={() => prop.onEdit && prop.onEdit(row)} aria-label="edit">
                                <EditIcon fontSize="small" />
                            </IconButton>
                            <IconButton
                                size="small"
                                color="error"
                                onClick={() => {
                                if (!prop.onDelete) return;
                                const confirmed = window.confirm("Are you sure you want to delete this entry?");
                                if (confirmed) prop.onDelete(row.id);
                                }}
                                aria-label="delete"
                            >
                                <DeleteIcon fontSize="small" />
                            </IconButton>
                        </Stack>
                    </TableCell>
                </TableRow>
                ))
            )}
        </TableBody>
      </Table>
    </TableContainer>
  );
};
export default TimesheetTable;
